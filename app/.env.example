# Copy to .env.local and fill in. Values shown are the development defaults.

# Secret used to sign sessions/cookies (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Absolute URL the API is reachable at
BETTER_AUTH_URL=http://localhost:3001

# Origin of the client app. Must match the port the Vite dev server uses
# (VITE_PORT in client/.env.local) — it is used for CORS + better-auth trustedOrigins.
CLIENT_URL=http://localhost:5180

# Postgres connection string (docker compose provides this database)
DATABASE_URL="postgresql://postgres:pastpost@localhost:5432/aggregator"

PORT=3001
NODE_ENV=development

# Optional — Google OAuth is only enabled when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound mail. `none` is the default and sends nothing at all — no socket is
# opened, which is what keeps tests off the network. Set `reloop` once a
# verified sending domain exists; until then mail is silently dropped.
MAIL_PROVIDER=none

# Required when MAIL_PROVIDER=reloop. `RELOOP_FROM` accepts a bare address or
# the display-name form, e.g. `Aggregator <hello@example.com>`.
RELOOP_API_KEY=
RELOOP_FROM=

# Whether an unverified account is refused at the publish routes (docs/MARATHON
# `be-07`). Leave unset: it then follows MAIL_PROVIDER, so the gate arms itself
# once a real provider is configured and never locks publishing out while there
# is no way to send the verification link. Set `true` to arm it early, or
# `false` to allow unverified publishing with mail on.
ENFORCE_EMAIL_VERIFICATION=

# Optional — set to true ONLY when the API runs behind a proxy/CDN that
# overwrites x-forwarded-for. It makes per-client rate limiting see the real
# client IP instead of the proxy's. Leave false when the API is exposed
# directly, or a caller could spoof a header to dodge its limits.
TRUST_PROXY=false
