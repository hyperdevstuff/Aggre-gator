# Copy to .env.test.local (git-ignored). Used by `bun run test`.
# Tests run against their own database so they never touch dev data.

DATABASE_URL="postgresql://postgres:pastpost@localhost:5432/aggregator_test"
BETTER_AUTH_URL="http://localhost:3001"
CLIENT_URL="http://localhost:5180"
BETTER_AUTH_SECRET=replace-with-the-same-secret-as-app/.env.local
NODE_ENV="test"

# Tests must never reach a mail provider. The default is `none` (a real no-op)
# and is spelled out here so a copied `.env.local` cannot turn it into a live
# send from the test suite.
MAIL_PROVIDER=none

# Arm the publish gate (`be-07`) even though no provider is configured, so the
# "unverified cannot publish" path is provable here. In production this is left
# unset and derived from MAIL_PROVIDER — see resolveEnforceEmailVerification in
# src/env.ts for why arming it without mail is an outage rather than a control.
ENFORCE_EMAIL_VERIFICATION=true

