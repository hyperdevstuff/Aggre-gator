# Copy to .env.test.local (git-ignored). Used by `bun run test`.
# Tests run against their own database so they never touch dev data.

DATABASE_URL="postgresql://postgres:pastpost@localhost:5432/aggregator_test"
BETTER_AUTH_URL="http://localhost:3001"
CLIENT_URL="http://localhost:5180"
BETTER_AUTH_SECRET=replace-with-the-same-secret-as-app/.env.local
NODE_ENV="test"
