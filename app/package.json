{
  "name": "app",
  "version": "0.0.5",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test --env-file=.env.test.local",
    "typecheck": "tsc --noEmit",
    "check:db": "bun run --env-file=.env.local scripts/check-db.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.test.config.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.30",
    "metascraper": "^5.56.2",
    "metascraper-description": "^5.56.2",
    "metascraper-image": "^5.56.2",
    "metascraper-title": "^5.56.2",
    "metascraper-url": "^5.56.2",
    "metascraper-x": "^5.56.2",
    "metascraper-youtube": "^5.56.2",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "@sinclair/typebox": "^0.34.52",
    "@types/pg": "^8.23.1",
    "@types/bun": "^1.4.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "module": "src/index.js"
}