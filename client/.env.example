# Copy to .env.local and fill in. Values shown are the development defaults.

# Base URL of the API
VITE_API_URL=http://localhost:3001

# Must match the API's BETTER_AUTH_URL
BETTER_AUTH_URL=http://localhost:3001

# Port the dev server listens on. Keep CLIENT_URL in app/.env.local in sync.
VITE_PORT=5180
